# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/adwise

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=30

# Used to build links back to the frontend (e.g. password reset emails)
FRONTEND_URL=http://localhost:3000

# Google Sign-In (OAuth id token verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Ads API
CLIENT_ID=
CLIENT_SECRET=
DEVELOPER_TOKEN=
LOGIN_CUSTOMER_ID=
REFRESH_TOKEN=

# OpenAI (AI campaign generation)
OPENAI_API_KEY=

# SMTP (password reset emails) - example values for a Gmail app password;
# swap for your provider of choice (SendGrid, Resend, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@adwise.com
